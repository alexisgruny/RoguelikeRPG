{
  "compilerOptions": {
    "target": "ES6",
    "module": "ESNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": "./src", // Définit le point de départ pour les chemins absolus
    "paths": {
      "*": [
        "*"
      ],
      "components/*": [
        "components/*"
      ],
      "systems/*": [
        "systems/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}